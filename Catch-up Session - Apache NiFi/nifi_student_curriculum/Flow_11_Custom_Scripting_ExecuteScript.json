            "annotationData": ""
          },
          {
            "identifier": "1a09791d-9b2f-4eb2-af56-05ceda3c7e66",
            "instanceIdentifier": "b67f6808-b152-4569-a6e2-0b66c5515aa8",
            "name": "Calculate Distance (Groovy)",
            "type": "org.apache.nifi.processors.script.ExecuteScript",
            "bundle": {
              "group": "org.apache.nifi",
              "artifact": "nifi-scripting-nar",
              "version": "2.10.0"
            },
            "componentType": "PROCESSOR",
            "position": {
              "x": 0,
              "y": 200
            },
            "properties": {
              "Script Engine": "Groovy",
              "Script Body": "import groovy.json.JsonSlurper\nimport groovy.json.JsonOutput\nimport java.nio.charset.StandardCharsets\n\ndef flowFile = session.get()\nif (!flowFile) return\n\ndef text = new String(flowFile.read().getBytes(), StandardCharsets.UTF_8)\ndef json = new JsonSlurper().parseText(text)\n\ndouble lat1 = json.lat1, lon1 = json.lon1\ndouble lat2 = json.lat2, lon2 = json.lon2\ndouble R = 6371.0\n\ndouble dLat = Math.toRadians(lat2 - lat1)\ndouble dLon = Math.toRadians(lon2 - lon1)\ndouble a = Math.sin(dLat / 2) ** 2 +\n        Math.cos(Math.toRadians(lat1)) * Math.cos(Math.toRadians(lat2)) * Math.sin(dLon / 2) ** 2\ndouble c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a))\ndouble distanceKm = R * c\n\nflowFile = session.putAttribute(flowFile, 'distance_km', String.format('%.2f', distanceKm))\nsession.transfer(flowFile, REL_SUCCESS)\n"
            },
            "propertyDescriptors": {},
            "style": {},
