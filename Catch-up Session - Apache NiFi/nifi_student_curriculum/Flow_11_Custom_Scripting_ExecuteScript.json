            "properties": {
              "generate-ff-custom-text": "{\n  \"origin\": \"Kurunegala Branch\",\n  \"lat1\": 7.4863,\n  \"lon1\": 80.3647,\n  \"destination\": \"Customer Address\",\n  \"lat2\": 6.9271,\n  \"lon2\": 79.8612\n}",
